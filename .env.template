# Copy to .env.live and fill in (gitignored). Live tests are opt-in: pytest --live
#
# EDR_SERVER is the tenant base URL (no scheme needed; https is forced).
# EDR_USERNAME is the login WITHOUT the organization prefix when
#   EDR_ORGANIZATION is set -- the client qualifies it to <org>\<user>.
#   If your username already carries the <org>\<user> prefix, leave
#   EDR_ORGANIZATION blank.
EDR_SERVER=edr.example.com
EDR_USERNAME=
EDR_PASSWORD=
EDR_ORGANIZATION=
EDR_VERIFY_SSL=false
