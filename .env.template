# Copy to .env.live and fill in (gitignored). Live tests are opt-in: pytest --live
#
# EDR_SERVER is the tenant base URL (no scheme needed; https is forced).
# EDR_USERNAME is the login WITHOUT the organization prefix when
#   EDR_ORGANIZATION is set -- the client qualifies it to <org>\<user>.
#   If your username already carries the <org>\<user> prefix, leave
#   EDR_ORGANIZATION blank.
EDR_SERVER=edr.example.com
EDR_USERNAME=
EDR_PASSWORD=
EDR_ORGANIZATION=
EDR_VERIFY_SSL=false

# Per-tenant targets for the live suites, all optional -- a test that needs
# a target and does not find one skips itself:
#
# EDR_DEMO_EVENT_ID - an event that keeps absorbing re-detections (its
#   firstSeen stays pinned while its lastSeen moves). exercises the
#   activity-window semantics itself, list-events-extended, raw-data reads.
# EDR_SACRIFICIAL_EVENT_ID - an event approved as the carrier for the
#   exception round trip. use an event nobody minds an exception rule on;
#   the suite creates the rule, proves the honest update failure, then
#   DELETES the rule again (v2's delete_exception).
# EDR_ROUNDTRIP_COLLECTOR - a collector approved for the isolate/move/
#   state round trips. every round trip restores prior state; choose one
#   whose group membership is safe to move there and back deliberately.
EDR_DEMO_EVENT_ID=
EDR_SACRIFICIAL_EVENT_ID=
EDR_ROUNDTRIP_COLLECTOR=
