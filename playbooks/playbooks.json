          "steps": [
            {
              "@type": "WorkflowStep",
              "name": "Start",
              "description": null,
              "arguments": {
                "step_variables": {
                  "input": {
                    "params": []
                  },
                  "_configuration_schema": "[{\"title\": \"Initial Backfill Range (minutes)\", \"required\": true, \"editable\": true, \"visible\": true, \"type\": \"select\", \"name\": \"fetch_last_minutes\", \"options\": [\"20\", \"60\", \"360\", \"1440\", \"10080\", \"43200\"], \"value\": \"60\", \"tooltip\": \"How many minutes back the first run reads, before a last-pull-time watermark exists. Later runs read from the watermark.\"}, {\"title\": \"Time Field\", \"required\": true, \"editable\": true, \"visible\": true, \"type\": \"select\", \"name\": \"time_field\", \"options\": [\"Last Seen (activity)\", \"First Seen (creations only)\"], \"value\": \"Last Seen (activity)\", \"tooltip\": \"Last Seen (activity) fetches every event created or re-triggered in the window. FortiEDR links a re-detection of the same process into the existing event, whose firstSeen never moves -- use First Seen (creations only) only if you want the shipped connector's created-only behavior, which misses re-triggered events.\"}, {\"title\": \"Maximum Events Per Run\", \"required\": false, \"editable\": true, \"visible\": true, \"type\": \"text\", \"name\": \"max_events\", \"value\": \"2000\", \"tooltip\": \"Safety cap on one run's window. A window whose event count exceeds it fails the run instead of silently skipping events -- raise the cap or shorten the schedule rather than let it bind.\"}]"
                }
              },
              "status": null,
              "top": "120",
              "left": "200",
              "stepType": "/api/3/workflow_step_types/b348f017-9a94-471f-87f8-ce88b6a7ad62",
